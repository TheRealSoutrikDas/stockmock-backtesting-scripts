# No credentials here. You log in yourself in the browser window that
# session_manager.py opens, and it saves the resulting session to session.json.

# StockMock is a hash-bang single-page app. The backtest builder is at
# /#!/home (confirmed from the address bar when logged in). The plain paths
# (/backtest.html, /strategy-builder.html) are MARKETING pages, not the app.
# Note that /#!/builder is the live Strategy Builder, a different page.
# The builder URL is QUOTED on purpose. python-dotenv treats '#' as the start
# of a comment when whitespace precedes it, so an accidental space before the
# '#' would silently truncate this to "https://www.stockmock.in/" and land the
# script on the marketing homepage with no form on it. Quoting removes that
# risk entirely. Keep the quotes.
STOCKMOCK_BASE_URL=https://www.stockmock.in
STOCKMOCK_BUILDER_URL="https://www.stockmock.in/#!/home"

# Interaction timeout, in ms.
DEFAULT_TIMEOUT_MS=30000

# How long to wait for a backtest to finish, in ms. StockMock usually returns
# in seconds, but leave headroom.
RESULT_TIMEOUT_MS=120000

# Throttle between runs, in seconds. Do not set this to 0.
DELAY_BETWEEN_RUNS=4
